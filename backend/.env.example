# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Database & Auth (Backend-only private secrets)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Payments (Milestone 9)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Resend Email (Milestone 10)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Bloomncharms <orders@bloomncharms.com>
STORE_ADMIN_EMAIL=admin@bloomncharms.com

# Shiprocket Shipping (Milestone 11)
SHIPROCKET_EMAIL=shipping@bloomncharms.com
SHIPROCKET_PASSWORD=your_shiprocket_password
# SHIPROCKET_API_TOKEN=your_direct_token_if_static
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret
SHIPROCKET_PICKUP_LOCATION=Primary Atelier
